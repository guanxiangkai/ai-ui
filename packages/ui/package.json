    "@vue/test-utils": "catalog:",
    "element-plus": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "unplugin-dts": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
